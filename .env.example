# ===== 共通 =====
# Neon の接続文字列（pooled。Vercel の Storage から Neon を作ると自動で入る）
DATABASE_URL=postgres://devote:devote@localhost:5432/devote
# 本番URL（通知内のリンクに使う）本番: https://app.devote-inc.jp
APP_URL=http://localhost:3000

# ===== Web（Vercel） =====
# 16文字以上のランダム文字列（openssl rand -base64 32）
SESSION_SECRET=
# 管理画面 /admin の Basic 認証
ADMIN_USER=admin
ADMIN_PASSWORD=
# Claude API
ANTHROPIC_API_KEY=
# 会話モデル（既定: claude-opus-5-5）と思考の深さ（low / medium / high）
DEVOTE_CHAT_MODEL=claude-opus-5-5
DEVOTE_CHAT_EFFORT=medium
# LINE 公式アカウントの友だち追加URL（https://lin.ee/xxxx）
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=

# ===== 通知（Web と GitHub Actions の両方） =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE の月間無料通数（コミュニケーションプラン=200）。超えたらメールに切り替える
LINE_MONTHLY_LIMIT=200
RESEND_API_KEY=
# 本番: Devote <noreply@mail.devote-inc.jp>（Resend で mail.devote-inc.jp を認証）
MAIL_FROM=

# ===== 巡回（GitHub Actions / ローカル） =====
REINS_USER_ID=
REINS_PASSWORD=
ATBB_USER_ID=
ATBB_PASSWORD=
ITANDI_EMAIL=
ITANDI_PASSWORD=
# レインズの月間上限（検索・物件詳細それぞれ。6,000件まで無料、超過分は1件3円）
REINS_MONTHLY_SEARCH_LIMIT=6000
REINS_MONTHLY_DETAIL_LIMIT=6000
# 未検証のアダプター（会員サイト）も巡回するなら 1
ENABLE_UNVERIFIED_SOURCES=
# 巡回するソースを絞る（カンマ区切り。空なら全て）
DEVOTE_SOURCES=

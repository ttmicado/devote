{
  "name": "devote",
  "private": true,
  "version": "0.0.0",
  "description": "あなたにピッタリ合う物件を、最速で・手間なく・くまなく提案してくれるAI",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @devote/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @devote/db generate",
    "db:migrate": "pnpm --filter @devote/db migrate",
    "scrape": "pnpm --filter @devote/scraper scrape",
    "worker": "pnpm --filter @devote/pipeline worker",
    "dev": "pnpm --filter @devote/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
